# Rocket.Chat REST API base URL (no websockets - the bot polls for new
# messages, so this must be reachable over plain HTTP(S)).
ROCKETCHAT_URL=http://localhost:3000
ROCKETCHAT_USER_ID=change-me
ROCKETCHAT_TOKEN=change-me
# Set to false to skip TLS certificate verification (e.g. self-signed
# certs). Only do this for a trusted instance - it disables protection
# against man-in-the-middle attacks.
ROCKETCHAT_VERIFY_SSL=true

# Ollama connection
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_SYSTEM_PROMPT=You are a helpful assistant answering questions in a Rocket.Chat channel.

# Bot behaviour
# Prefix a message must start with for the bot to respond, e.g.
# "/rockbot what's the capital of France?". Everything else is ignored.
ROCKBOT_TRIGGER=/rockbot
# How often (seconds) to poll each room for new messages.
ROCKBOT_POLL_INTERVAL=2
ROCKBOT_HISTORY_LENGTH=10
ROCKBOT_LOG_LEVEL=INFO
