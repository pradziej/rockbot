# Rocket.Chat connection
ROCKETCHAT_URL=ws://localhost:3000/websocket
ROCKETCHAT_USERNAME=rockbot
ROCKETCHAT_PASSWORD=change-me

# Ollama connection
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_SYSTEM_PROMPT=You are a helpful assistant answering questions in a Rocket.Chat channel.

# Bot behaviour
ROCKBOT_HISTORY_LENGTH=10
ROCKBOT_LOG_LEVEL=INFO
